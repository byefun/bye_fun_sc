# Cluster selection for scripts (devnet | mainnet-beta)
# Honored by scripts/constants.ts
CLUSTER=devnet

# Optional RPC overrides — leave blank to use defaults from scripts/constants.ts
RPC_URL=
WSS_URL=

# Path on host (relative to repo root) to the deployer keypair file.
# Mounted read-only at /run/secrets/deployer inside the deploy-devnet service.
DEPLOYER_KEYPAIR_PATH=./accounts/dev/deployer.json

# Path on host (relative to repo root) to the program keypair file.
# Used by `solana program deploy --program-id`.
PROGRAM_KEYPAIR_PATH=./accounts/dev/bye_machine-keypair.json
