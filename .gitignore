# T-50: target/idl/bye_machine.json is tracked, not generated fresh — three unit test files
# (tests/unit/idl-oracle*.test.ts, tests/unit/idl-vs-rust-accounts.test.ts) load it at run time,
# and CI has no `anchor build` step to produce it. Everything else under target/ stays ignored.
target/*
!target/idl/
target/idl/*
!target/idl/bye_machine.json

