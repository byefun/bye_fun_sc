# Generated by Cargo
debug
target/*

# Anchor
.anchor
test-ledger

# Node — pnpm is the package manager (pnpm-lock.yaml IS committed)
node_modules
package-lock.json
yarn.lock
.pnpm-store

# Build logs. CI tees `cargo build-sbf` into these so check-frame-overflow.sh can read the
# frame diagnostics the build's exit code does not report; running the same commands
# locally produces them too.
build-testing.log
build-dev.log

# rustfmt backups
**/*.rs.bk

# MSVC debug info
*.pdb

# cargo mutants output
**/mutants.out*/

# RustRover / JetBrains
#.idea/

.env
.env.*
.claude/

# Keypairs and any other local account material — never tracked.
accounts/
local/*

# macOS
.DS_Store
